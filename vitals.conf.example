# claude-vitals — configuración opcional.
# Copia este archivo a ~/.claude/vitals.conf y descomenta lo que quieras cambiar.
# Es sintaxis de shell (lo cargan vitals.sh y vitals-hook.sh con `source`).

## Módulos de la statusline (1 = on, 0 = off)
#VITALS_SEMAFORO=1        # 🟢/🟡/🔴 por sesión
#VITALS_MODEL=1           # nombre del modelo
#VITALS_CTX=1             # % de contexto usado/restante
#VITALS_COST=1            # costo acumulado de la sesión en USD
#VITALS_GIT=1             # rama git del workspace, con * si hay cambios
#VITALS_IDLE_TIME=1       # cuánto lleva detenida/esperando la sesión
#VITALS_RC=1              # 📡 al final de la línea si Remote Control está conectado
#VITALS_AUDIT=1           # ⚖ fase de la auditoría tri-audit del proyecto (.audit/estado.md)
#VITALS_AUDIT_CACHE_SECS=15 # cada cuántos segundos re-leer estado.md

## Umbrales y tiempos
#VITALS_CTX_ALERT=80      # % de contexto usado a partir del cual se pinta rojo
#VITALS_GIT_CACHE_SECS=10 # cada cuántos segundos re-consultar git

## vitals ai (salud de las cuentas de IA)
#VITALS_AI_TIMEOUT=60     # segundos máximos por IA en `vitals ai --live`
#GEMINI_MODEL=gemini-pro-latest # modelo para el ping a la Gemini API
#VITALS_AI_BADGE=1        # badge "3IA ✓/✗" en la statusline (usa el cache, nunca llama directo)
#VITALS_AI_TTL_HOURS=5    # edad máxima del cache antes de re-chequear en background

## Hook (color de tab y notificaciones)
#VITALS_TAB_COLOR=1       # pintar el tab de iTerm2 según estado
#VITALS_NOTIFY=1          # notificación de macOS cuando una sesión queda esperando
#VITALS_NOTIFY_DELAY=10   # segundos esperando antes de notificar (anti-ruido)
