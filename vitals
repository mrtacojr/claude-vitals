#!/usr/bin/env bash
# vitals — resumen de tus sesiones de Claude Code y salud de las cuentas de IA.
#
#   vitals                resumen de todas las sesiones (las que te esperan primero)
#   vitals go [n|nombre]  salta a la ventana de la sesión (por defecto, la que te espera)
#   vitals demo [hex] [s]  previsualiza aquí las señales de "te espera" y las revierte
#   vitals --porcelain    una línea TSV por sesión, para scripts
#   vitals reset-colors   devuelve esta terminal a su color y quita el badge
#   vitals ai             chequeo rápido de las 3 cuentas de IA (config/credenciales)
#   vitals ai --live      prueba real de ida y vuelta a las 3 IAs, en paralelo
#
# Las "3 IAs" son las cuentas de la metodología tri-audit: Claude Code,
# OpenAI Codex CLI y Google Gemini API.

configDir="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
state_dir="$configDir/vitals-state"

# Config y librería compartida (resolviendo el symlink de instalación)
[ -f "$configDir/vitals.conf" ] && . "$configDir/vitals.conf"
: "${VITALS_AI_TIMEOUT:=60}"
: "${GEMINI_MODEL:=gemini-pro-latest}"

self="$0"; [ -L "$self" ] && self="$(readlink "$self")"
libfile="$(cd "$(dirname "$self")" && pwd)/vitals-lib.sh"
[ -f "$libfile" ] && . "$libfile"

fmt_age() { # segundos -> "45s" / "12m" / "1h05m"
  local s=$1
  if [ "$s" -lt 60 ]; then printf '%ds' "$s"
  elif [ "$s" -lt 3600 ]; then printf '%dm' "$((s / 60))"
  else printf '%dh%02dm' "$((s / 3600))" "$(((s % 3600) / 60))"
  fi
}

# ============================ vitals ai ============================

run_to() { # run_to <timeout_s> cmd...  — mata el comando si excede el timeout
  local t=$1; shift
  "$@" &
  local pid=$!
  # el watchdog suelta stdout/stderr para no mantener abierto el pipe del
  # command substitution que envuelve a run_to
  ( sleep "$t" && kill "$pid" 2>/dev/null ) >/dev/null 2>&1 &
  local wd=$!
  wait "$pid" 2>/dev/null; local rc=$?
  kill "$wd" 2>/dev/null; wait "$wd" 2>/dev/null
  return $rc
}

gemini_key() {
  if [ -n "${GEMINI_API_KEY:-}" ]; then printf '%s' "$GEMINI_API_KEY"
  else cat "${GEMINI_API_KEY_FILE:-$HOME/.config/gemini/api_key}" 2>/dev/null
  fi
}

# Cuenta archivos de sesión reales, sin contar caches ni el cache global ai-health
count_sessions() {
  local f n=0
  for f in "$state_dir"/*; do
    [ -f "$f" ] || continue
    vitals_is_session_file "$f" || continue
    n=$((n + 1))
  done
  printf '%d' "$n"
}

ai_fast() {
  echo "Chequeo de configuración (para prueba real: vitals ai --live)"
  echo

  # Claude
  if command -v claude >/dev/null 2>&1; then
    v=$(claude --version 2>/dev/null | head -n 1)
    echo "Claude   ✅ CLI ${v:-instalada} · $(count_sessions) sesiones registradas"
  else
    echo "Claude   ❌ CLI 'claude' no encontrada en PATH"
  fi

  # Codex
  if command -v codex >/dev/null 2>&1; then
    v=$(codex --version 2>/dev/null | head -n 1)
    if [ -f "$HOME/.codex/auth.json" ]; then
      echo "Codex    ✅ CLI ${v:-instalada} · auth.json presente"
    else
      echo "Codex    ⚠️  CLI ${v:-instalada} · SIN ~/.codex/auth.json (corre: codex login)"
    fi
  else
    echo "Codex    ❌ CLI 'codex' no encontrada en PATH"
  fi

  # Gemini
  if [ -n "$(gemini_key)" ]; then
    echo "Gemini   ✅ API key presente · modelo $GEMINI_MODEL"
  else
    echo "Gemini   ❌ sin API key (GEMINI_API_KEY o ~/.config/gemini/api_key)"
  fi
}

ai_live() {
  local tmp
  tmp=$(mktemp -d "${TMPDIR:-/tmp}/vitals-ai.XXXXXX")
  trap 'rm -rf "$tmp"' EXIT

  echo "Probando las 3 IAs en paralelo (timeout ${VITALS_AI_TIMEOUT}s)..."

  {
    t0=$(date +%s)
    out=$(run_to "$VITALS_AI_TIMEOUT" claude --model haiku -p "Responde únicamente: OK" 2>&1)
    rc=$?
    dt=$(( $(date +%s) - t0 ))
    if [ $rc -eq 0 ] && [ -n "$out" ]; then echo "OK|$dt|$(printf '%s' "$out" | tail -n 1)"
    else echo "FAIL|$dt|$(printf '%s' "$out" | head -n 1)"; fi
  } >"$tmp/claude" &

  {
    t0=$(date +%s)
    out=$(run_to "$VITALS_AI_TIMEOUT" codex exec --skip-git-repo-check -c sandbox_mode=read-only "Responde únicamente: OK" 2>/dev/null)
    rc=$?
    dt=$(( $(date +%s) - t0 ))
    if [ $rc -eq 0 ] && [ -n "$out" ]; then echo "OK|$dt|$(printf '%s' "$out" | tail -n 1)"
    else echo "FAIL|$dt|codex exec falló (rc=$rc)"; fi
  } >"$tmp/codex" &

  {
    t0=$(date +%s)
    key=$(gemini_key)
    if [ -z "$key" ]; then
      echo "FAIL|0|sin API key"
    else
      # La API key va por cabecera y no en la URL: los argumentos de curl son
      # visibles para cualquier proceso local vía `ps`, las cabeceras leídas
      # desde --config no.
      out=$(printf 'header = "x-goog-api-key: %s"\n' "$key" | curl -s --config - \
        --max-time "$VITALS_AI_TIMEOUT" \
        "https://generativelanguage.googleapis.com/v1beta/models/${GEMINI_MODEL}:generateContent" \
        -H 'Content-Type: application/json' \
        -d '{"contents":[{"parts":[{"text":"Responde únicamente: OK"}]}]}' \
        | jq -r '.candidates[0].content.parts[0].text // ("ERROR: " + (.error.message // "respuesta vacía"))' 2>/dev/null)
      dt=$(( $(date +%s) - t0 ))
      case "$out" in
        ERROR:*|"") echo "FAIL|$dt|${out:-sin respuesta de la API}" ;;
        *)          echo "OK|$dt|$out" ;;
      esac
    fi
  } >"$tmp/gemini" &

  wait
  echo

  # Cache para el badge 3IA de la statusline: "ia:ESTADO:latencia ..."
  mkdir -p "$state_dir"
  cacheline=""
  for ia in claude codex gemini; do
    IFS='|' read -r st dt detail <"$tmp/$ia"
    cacheline+="${ia}:${st}:${dt} "
    name=$(printf '%-8s' "$(echo "$ia" | awk '{print toupper(substr($0,1,1)) substr($0,2)}')")
    case "$ia" in gemini) extra=" ($GEMINI_MODEL)" ;; *) extra="" ;; esac
    if [ "$st" = OK ]; then
      echo "$name ✅ respondió en ${dt}s$extra"
    else
      echo "$name ❌ FALLÓ tras ${dt}s$extra — ${detail:-sin detalle}"
    fi
  done
  printf '%s\n' "$cacheline" >"$state_dir/ai-health"
}

# ======================= inventario de sesiones =======================

# Emite una fila TSV por sesión viva:
#   orden \t estado \t proyecto \t segundos \t uuid_iterm \t badge_audit
# El orden pone primero las que te esperan. Las sesiones cuyo proceso claude ya
# no existe se descartan aquí: sin esto, una terminal cerrada seguiría gritando
# "esperando" durante días y `vitals go` saltaría a ventanas fantasma.
collect_sessions() {
  local f state cwd uuid pid proj mt now key badge
  now=$(date +%s)
  for f in "$state_dir"/*; do
    [ -f "$f" ] || continue
    vitals_is_session_file "$f" || continue

    state=$(sed -n 1p "$f")
    cwd=$(sed -n 2p "$f")
    uuid=$(sed -n 3p "$f")
    pid=$(sed -n 4p "$f")

    vitals_alive "$pid"
    [ $? -eq 1 ] && continue    # 0 = viva · 2 = desconocida (versión anterior)

    proj=$(basename "${cwd:-¿?}")
    mt=$(stat -f %m "$f" 2>/dev/null || echo "$now")

    case "$state" in
      waiting) key=0 ;;
      working) key=1 ;;
      *)       key=2 ;;
    esac

    badge=""
    if [ -n "$cwd" ] && type vitals_audit_badge >/dev/null 2>&1; then
      badge=$(vitals_audit_badge "$cwd")
    fi

    printf '%s\t%s\t%s\t%s\t%s\t%s\n' \
      "$key" "$state" "$proj" "$((now - mt))" "$uuid" "$badge"
  done
}

cmd_summary() {
  local rows waiting=0 working=0 idle=0 n=0
  rows=$(collect_sessions | sort -t$'\t' -k1,1n -k4,4nr)

  if [ -z "$rows" ]; then
    echo "No hay sesiones de Claude Code activas."
    exit 0
  fi

  while IFS=$'\t' read -r key state proj secs uuid badge; do
    n=$((n + 1))
    case "$state" in
      waiting) icon="🔴"; label="esperando";  extra="(necesita tu respuesta)"; waiting=$((waiting + 1)) ;;
      working) icon="🟢"; label="trabajando"; extra=""; working=$((working + 1)) ;;
      *)       icon="🟡"; label="detenida";   extra=""; idle=$((idle + 1)) ;;
    esac
    case "$badge" in
      "")           : ;;
      OK)           extra="⚖ ✓ $extra" ;;
      STOP*|*gate*) extra="⚖ $badge ⚠ $extra" ;;
      *)            extra="⚖ $badge $extra" ;;
    esac
    printf '%2d. %s %-11s %-28s %-7s %s\n' \
      "$n" "$icon" "$label" "$proj" "$(fmt_age "$secs")" "$extra"
  done <<<"$rows"

  echo
  echo "── $n sesiones: $working trabajando · $waiting esperándote · $idle detenidas"
  [ "$waiting" -gt 0 ] && echo "   vitals go   salta a la que lleva más tiempo esperándote"
  return 0
}

# ============================ vitals go ============================

# Trae al frente la sesión de iTerm2 con ese UUID, cambiando de Space si hace
# falta. El UUID lo guarda el hook desde ITERM_SESSION_ID; es estable aunque
# muevas la pestaña de ventana.
focus_iterm_session() { # $1 = uuid
  osascript - "$1" <<'OSA' 2>/dev/null
on run argv
  set target to item 1 of argv
  tell application "iTerm2"
    repeat with w in windows
      repeat with t in tabs of w
        repeat with s in sessions of t
          if (id of s) is target then
            select s
            select t
            select w
            activate
            return "ok"
          end if
        end repeat
      end repeat
    end repeat
  end tell
  return "notfound"
end run
OSA
}

cmd_go() { # $1 = índice, parte del nombre del proyecto, o vacío
  local target="${1:-}" rows pick n=0
  rows=$(collect_sessions | sort -t$'\t' -k1,1n -k4,4nr)
  [ -n "$rows" ] || { echo "No hay sesiones de Claude Code activas."; exit 1; }

  if [ -z "$target" ]; then
    # sin argumento: la que lleva más tiempo esperándote
    pick=$(printf '%s\n' "$rows" | awk -F'\t' '$2 == "waiting" {print; exit}')
    [ -n "$pick" ] || { echo "Ninguna sesión te está esperando."; echo; cmd_summary; exit 1; }
  elif [[ "$target" =~ ^[0-9A-Fa-f-]{36}$ ]]; then
    # UUID exacto: es como el ítem de barra de menú identifica cada sesión,
    # porque dos proyectos pueden llamarse igual
    pick=$(printf '%s\n' "$rows" | awk -F'\t' -v u="$target" '$5 == u {print; exit}')
    [ -n "$pick" ] || { echo "Esa sesión ya no está activa."; exit 1; }
  elif [ "$target" -eq "$target" ] 2>/dev/null; then
    pick=$(printf '%s\n' "$rows" | sed -n "${target}p")
    [ -n "$pick" ] || { echo "No hay una sesión número $target."; exit 1; }
  else
    pick=$(printf '%s\n' "$rows" | awk -F'\t' -v pat="$target" 'index(tolower($3), tolower(pat)) {print; exit}')
    [ -n "$pick" ] || { echo "Ninguna sesión activa coincide con '$target'."; exit 1; }
  fi

  IFS=$'\t' read -r key state proj secs uuid badge <<<"$pick"

  if [ -z "$uuid" ]; then
    echo "No sé en qué ventana vive '$proj': su estado lo escribió una versión"
    echo "anterior de vitals. Se arregla solo en cuanto esa sesión haga algo."
    exit 1
  fi

  case "$state" in
    waiting) echo "→ $proj (esperándote hace $(fmt_age "$secs"))" ;;
    working) echo "→ $proj (trabajando)" ;;
    *)       echo "→ $proj (detenida hace $(fmt_age "$secs"))" ;;
  esac

  if [ "$(focus_iterm_session "$uuid")" != ok ]; then
    echo "   ...pero iTerm2 ya no tiene esa sesión abierta."
    exit 1
  fi
}

# ========================== despacho de comandos ==========================

case "${1:-}" in
  ai)
    if [ "${2:-}" = "--live" ]; then ai_live; else ai_fast; fi
    exit 0
    ;;
  go)
    cmd_go "${2:-}"
    exit $?
    ;;
  --porcelain)
    # TSV estable para consumidores externos (el ítem de barra de menú):
    #   estado \t proyecto \t segundos \t uuid \t badge_audit
    collect_sessions | sort -t$'\t' -k1,1n -k4,4nr | cut -f2-
    exit 0
    ;;
  demo)
    # Previsualiza en esta terminal las señales de "te espera" y las revierte
    # sola. Sirve para calibrar el color contra Mission Control, que es donde
    # de verdad importa que destaque.
    if ! type vitals_bg_set >/dev/null 2>&1; then
      echo "No encuentro vitals-lib.sh junto a $self" >&2; exit 1
    fi
    hex="${2:-${VITALS_BG_WAITING:-4a1015}}"
    secs="${3:-15}"
    vitals_bg_set "$hex"
    vitals_badge_set "${VITALS_BADGE_TEXT:-ESPERA}
$(basename "$PWD")"
    vitals_attention "${VITALS_ATTENTION:-once}"
    echo "Fondo #$hex + badge aplicados por ${secs}s — míralo desde Mission Control."
    sleep "$secs"
    vitals_bg_reset
    vitals_badge_clear
    echo "Revertido."
    exit 0
    ;;
  reset-colors)
    # Escotilla manual: si una terminal quedó pintada porque su sesión murió sin
    # limpiar, esto la devuelve a su color de perfil.
    if type vitals_bg_reset >/dev/null 2>&1; then
      vitals_bg_reset
      vitals_badge_clear
      echo "Fondo y badge de esta terminal restaurados."
    else
      echo "No encuentro vitals-lib.sh junto a $self" >&2
      exit 1
    fi
    exit 0
    ;;
  -h|--help)
    sed -n '2,13p' "$self" | sed 's/^# \{0,1\}//'
    exit 0
    ;;
esac

if [ ! -d "$state_dir" ]; then
  echo "No hay sesiones de Claude Code registradas."
  exit 0
fi

cmd_summary
